# Copy to .env (never committed) and fill in.

# Required. Encrypts the passwords and tokens of the accounts you connect. Make one with:
#   openssl rand -base64 32
# Keep a copy somewhere safe and apart from your database backups: without it, connected
# accounts must be reconnected; with it and the database, anyone can read them.
ORGANIZER_SECRET_KEY=

# Port on this machine's loopback (127.0.0.1) where the app listens.
ORGANIZER_PORT=8600

# Time zone used before setup picks one. Setup and Settings change it in the app.
DEFAULT_TIMEZONE=UTC

# Session cookie's Secure flag: auto (when the request came over HTTPS), always, never.
# Behind an HTTPS proxy (Tailscale, a Cloudflare Tunnel, Caddy...), set it to always.
COOKIE_SECURE=auto

# Addresses whose X-Forwarded-Proto is believed (whether a request came over HTTPS). Only the
# cookie's Secure flag under COOKIE_SECURE=auto depends on it. The sign-in throttle does not:
# it counts the last X-Forwarded-For entry, the one your proxy appended.
FORWARDED_ALLOW_IPS=*

# The address you reach the organizer at, e.g. https://organizer.example.com. Needed for Google
# sign-in when a proxy hides the real address; empty means "the address the request came in on".
PUBLIC_BASE_URL=

# Your own Google Cloud OAuth client, for Google Calendar and Gmail (docs/GOOGLE.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional: the MCP server for claude.ai (docs/MCP.md) ------------------------------------
# Start it with `docker compose --profile mcp up -d --build` (add `--profile mcp-mail` for the
# mail connector), or list the profiles here: COMPOSE_PROFILES=mcp,mcp-mail
#
# Tokens are made in Settings → API tokens, with author claude_remote. Each container refuses to
# start without its own. The general token never reads mail, and the mail token reads only mail.
# ORGANIZER_MCP_TOKEN=          # scope api; reaches organizer-mcp as ORGANIZER_TOKEN
# ORGANIZER_MCP_MAIL_TOKEN=     # scope mail; reaches organizer-mcp-mail as ORGANIZER_MAIL_TOKEN
#
# Cloudflare Access, one application per connector. The team domain and the allowed email are
# shared; each connector has its own public hostname and its application's AUD tag.
# CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# MCP_ALLOWED_EMAIL=you@example.com
# MCP_PUBLIC_HOST=organizer-mcp.example.com
# CF_ACCESS_AUD=
# MCP_MAIL_PUBLIC_HOST=organizer-mail-mcp.example.com
# MCP_MAIL_CF_ACCESS_AUD=
#
# Which toolsets organizer-mcp serves: all (every one but mail), or a comma list. 1 drops writes.
# ORGANIZER_MCP_TOOLSETS=all
# ORGANIZER_MCP_READ_ONLY=0
#
# Ports on this machine's loopback where the connectors listen; point your tunnel at them.
# MCP_PORT=8601
# MCP_MAIL_PORT=8602

# How many days of mail headers the inbox keeps (1-365).
MAIL_WINDOW_DAYS=30
