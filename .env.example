# Copy to .env (never committed) and fill in.

# Required. Encrypts the passwords and tokens of the accounts you connect. Make one with:
#   openssl rand -base64 32
# Keep a copy somewhere safe and apart from your database backups: without it, connected
# accounts must be reconnected; with it and the database, anyone can read them.
ORGANIZER_SECRET_KEY=

# Port on this machine's loopback (127.0.0.1) where the app listens.
ORGANIZER_PORT=8600

# Time zone used before setup picks one. Setup and Settings change it in the app.
DEFAULT_TIMEZONE=UTC

# Session cookie's Secure flag: auto (when the request came over HTTPS), always, never.
COOKIE_SECURE=auto

# Addresses allowed to set X-Forwarded-For/-Proto (your reverse proxy). The default trusts any,
# which is safe only because the port is published on loopback.
FORWARDED_ALLOW_IPS=*

# The address you reach the organizer at, e.g. https://organizer.example.com. Needed for Google
# sign-in when a proxy hides the real address; empty means "the address the request came in on".
PUBLIC_BASE_URL=

# Your own Google Cloud OAuth client, for Google Calendar and Gmail (docs/GOOGLE.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
